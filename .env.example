# ─────────────────────────────────────────────────────────────
#  IngredientSight AI — environment variables
# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your REAL keys:
#      Linux/macOS:  cp .env.example .env
#      Windows:      copy .env.example .env
#
#  `.env` is gitignored — never commit it. All keys are read from
#  the environment at runtime (os.environ) and are never exposed
#  to the frontend or hardcoded in source files.
#
#  NOTE: if any of these keys were ever committed to git history,
#  rotate them at the provider and generate fresh ones.

# Google Gemini API key — used by the OCR, Ingredient, and Safety agents.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative legacy name (falls back to GEMINI_API_KEY if set).
GOOGLE_API_KEY=

# Tavily search API key — used by the Research agent to gather
# real ingredient evidence from the web. Get one at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Groq API key — reserved for optional future agents.
GROQ_API_KEY=

# OpenAI API key — optional; not currently used by the pipeline.
OPENAI_API_KEY=

┌─────────────────────────────────────────────────────────────────┐
# Production Deployment (Vercel + Render Setup)
└─────────────────────────────────────────────────────────────────┘
#
# IMPORTANT: Set the following environment variable in your Vercel project settings:
#
# Variable Name: VITE_API_URL
# Value: https://your-render-backend.onrender.com
#
# Example:
#   If your backend is deployed on Render at: https://ingredientsight-ai-backend.onrender.com
#   Then set VITE_API_URL=https://ingredientsight-ai-backend.onrender.com in Vercel Dashboard
#
# Steps to configure Vercel:
#   1. Go to your Vercel project dashboard
#   2. Navigate to Settings > Environment Variables
#   3. Add a new variable: VITE_API_URL = https://ingredientsight-ai-backend.onrender.com
#   4. Deploy again to apply changes
#
# Your frontend will automatically connect to the Render backend after this configuration.
